<idea-plugin>
    <id>com.github.senocak.autocommit</id>
    <name>Custom Commit AI</name>
    <vendor>Custom Commit AI</vendor>
    <description><![CDATA[Generate Git commit messages using a configurable HTTP API.]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.vcs</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationConfigurable
                parentId="tools"
                id="com.github.senocak.autocommit.settings"
                displayName="Custom Commit AI"
                instance="com.github.senocak.autocommit.settings.CustomCommitAiConfigurable"/>
        <notificationGroup id="Custom Commit AI" displayType="BALLOON" isLogByDefault="true"/>
    </extensions>

    <actions>
        <action id="AutoCommit.GenerateCommitMessage"
                class="com.github.senocak.autocommit.action.GenerateCommitMessageAction"
                text="Generate Commit Message"
                description="Generate a commit message from the current Git changes using a custom HTTP API."
                icon="/icons/sparkle.svg">
            <add-to-group group-id="ChangesView.CommitToolbar" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
